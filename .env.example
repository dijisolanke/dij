# Copy to .env for local dev (gitignored). Wrangler/astro dev read it automatically.
# In production, set these in Cloudflare → Workers → dij → Settings → Variables and Secrets
# (PUBLIC_* also need to be set as *build* variables, since they're inlined at build time).
# Schema + types live in astro.config.mjs (env.schema); import via astro:env/*.

# Sanity (see studio/README.md for how to get these)
PUBLIC_SANITY_PROJECT_ID=your-project-id
PUBLIC_SANITY_DATASET=production

# Used to build Stripe success/cancel redirect URLs
PUBLIC_SITE_URL=http://localhost:4321

# --- Secrets (server-only, never prefix with PUBLIC_) ---

# Stripe test keys: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_...
# Local: printed by `stripe listen --forward-to localhost:4321/api/stripe-webhook`
# Production: from the webhook endpoint in the Stripe dashboard
STRIPE_WEBHOOK_SECRET=whsec_...
# Comma-separated shipping rate IDs (Stripe → Product catalogue → Shipping rates)
STRIPE_SHIPPING_RATE_IDS=shr_...,shr_...

# Cloudflare Turnstile (bot check on Buy). These are Cloudflare's public TEST keys
# (invisible widget, always passes) — fine for local dev. Real keys: Cloudflare
# dashboard → Turnstile → Add widget (add your workers.dev + real domain).
PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000BB
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Protects the scheduled stale-reservation cleanup. Any long random string,
# e.g. `openssl rand -hex 32`. Use a different value per Worker.
CRON_SECRET=

# Sanity API token with Editor role (sanity.io/manage → API → Tokens); used for stock + orders
SANITY_WRITE_TOKEN=
