---
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container">
    <p>&copy; {year}. All rights reserved.</p>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--color-border);
    margin-top: var(--space-6);
    padding: var(--space-3) 0;
  }

  .footer p {
    margin: 0;
    font-size: 0.85rem;
    color: var(--color-text-muted);
  }
</style>
