---
interface Props {
  siteName: string;
}

// const { siteName } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container">
    <p>&copy; {year} IHDY Limited. All rights reserved.</p>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--color-border);
    padding: var(--space-3) 0;
    text-align: center;
  }

  .footer p {
    margin: 0;
    font-size: 0.85rem;
    color: var(--color-text-muted);
  }
</style>
