---
// Renders a Font Awesome Free icon as inline SVG at build/request time, so no
// icon font or client JS is shipped. Font Awesome Free icons are licensed
// CC BY 4.0 (https://fontawesome.com/license/free) — this notice is the
// attribution.
import type { IconDefinition } from '@fortawesome/fontawesome-common-types';

interface Props {
  icon: IconDefinition;
  class?: string;
}

const { icon, class: className } = Astro.props;
const [width, height, , , path] = icon.icon;
const paths = Array.isArray(path) ? path : [path];
---

<svg
  class:list={['icon', className]}
  viewBox={`0 0 ${width} ${height}`}
  aria-hidden="true"
  focusable="false"
  fill="currentColor"
>
  {paths.map((d) => <path d={d} />)}
</svg>

<style>
  .icon {
    width: 1em;
    height: 1em;
    flex-shrink: 0;
  }
</style>
