---
import Layout from '../layouts/Layout.astro';
import { LEGAL_LAST_UPDATED } from '../lib/company';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<Layout title={title} description={description}>
  <main id="main" class="container narrow page">
    <h1>{title}</h1>
    <p class="updated">Last updated: {LEGAL_LAST_UPDATED}</p>
    <div class="prose">
      <slot />
    </div>
  </main>
</Layout>

<style>
  .page {
    padding-top: var(--space-5);
    padding-bottom: var(--space-6);
  }

  h1 {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(2rem, 7vw, 3rem);
    text-transform: uppercase;
    line-height: 1.05;
  }

  .updated {
    margin-top: var(--space-1);
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }

  .prose {
    margin-top: var(--space-4);
    max-width: 68ch;
    line-height: 1.65;
  }

  .prose :global(h2) {
    margin-top: var(--space-4);
    font-weight: 900;
    font-size: 1.2rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .prose :global(h3) {
    margin-top: var(--space-3);
    font-weight: 700;
    font-size: 1.05rem;
  }

  .prose :global(p),
  .prose :global(ul),
  .prose :global(dl) {
    margin-top: var(--space-2);
  }

  .prose :global(ul) {
    padding-left: 1.25rem;
  }

  .prose :global(li + li) {
    margin-top: 0.4rem;
  }

  .prose :global(a) {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .prose :global(dt) {
    font-weight: 700;
    margin-top: var(--space-1);
  }

  .prose :global(dd) {
    margin: 0;
    color: var(--color-text-muted);
  }
</style>
