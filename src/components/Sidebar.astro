---
import { getSiteSettings } from '../lib/sanity';

const { pathname } = Astro.url;

let shopEnabled = true;
let siteName = 'Artist Name';
let tagline = '';
let socialLinks: { platform: string; url: string }[] = [];

try {
  const settings = await getSiteSettings();
  shopEnabled = settings.shopEnabled;
  siteName = settings.siteName || siteName;
  tagline = settings.tagline || '';
  socialLinks = settings.socialLinks || [];
} catch {
  // Sanity unreachable — fall back to defaults rather than breaking the page.
}

const links = [
  { href: '/', label: 'About Diji' },
  { href: '/gigs', label: 'Gigs' },
  { href: '/projects', label: 'Projects' },
  { href: '/shop', label: 'Shop', disabled: !shopEnabled },
  { href: '/watch', label: 'Watch' },
];

const badgeLabels: Record<string, string> = {
  Instagram: 'IG',
  'Twitter / X': 'X',
  Facebook: 'f',
  YouTube: 'YT',
  Bandcamp: 'BC',
  Soundcloud: 'SC',
};

function badgeFor(platform: string) {
  return badgeLabels[platform] || platform.charAt(0).toUpperCase();
}
---

<aside class="sidebar">
  <a href="/" class="brand">
    <span class="site-name">{siteName}</span>
    {tagline && <span class="tagline">{tagline}</span>}
  </a>

  <nav aria-label="Main">
    <ul>
      {links.map((link) => (
        <li>
          {link.disabled ? (
            <span class="disabled-wrap">
              <button type="button" class="disabled" aria-disabled="true" aria-describedby="shop-tooltip">
                {link.label}
              </button>
              <span class="tooltip" role="tooltip" id="shop-tooltip">Coming soon</span>
            </span>
          ) : (
            <a
              href={link.href}
              aria-current={
                link.href === '/'
                  ? pathname === '/' ? 'page' : undefined
                  : pathname.startsWith(link.href) ? 'page' : undefined
              }
            >
              {link.label}
            </a>
          )}
        </li>
      ))}
    </ul>
  </nav>

  {socialLinks.length > 0 && (
    <ul class="social">
      {socialLinks.map((link) => (
        <li>
          <a href={link.url} target="_blank" rel="noopener noreferrer" aria-label={link.platform} title={link.platform}>
            {badgeFor(link.platform)}
          </a>
        </li>
      ))}
    </ul>
  )}
</aside>

<script>
  document.querySelectorAll<HTMLElement>('.disabled-wrap').forEach((wrap) => {
    const button = wrap.querySelector('button');
    button?.addEventListener('click', (event) => {
      event.stopPropagation();
      document.querySelectorAll('.disabled-wrap.show-tooltip').forEach((other) => {
        if (other !== wrap) other.classList.remove('show-tooltip');
      });
      wrap.classList.toggle('show-tooltip');
    });
  });

  document.addEventListener('click', () => {
    document.querySelectorAll('.disabled-wrap.show-tooltip').forEach((wrap) => wrap.classList.remove('show-tooltip'));
  });
</script>

<style>
  .sidebar {
    width: 260px;
    flex-shrink: 0;
    padding: var(--space-4) var(--space-3);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    border-right: 1px solid var(--color-border);
  }

  @media (min-width: 801px) {
    .sidebar {
      position: sticky;
      top: 0;
      height: 100svh;
      overflow-y: auto;
    }
  }

  .brand {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    gap: 2px;
  }

  .site-name {
    font-weight: 600;
    font-size: 1.1rem;
    letter-spacing: -0.01em;
    color: var(--color-text);
  }

  .tagline {
    font-size: 0.85rem;
    color: var(--color-text-muted);
  }

  nav ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
  }

  nav a,
  nav .disabled {
    display: inline-block;
    text-decoration: none;
    font-size: 0.95rem;
    color: var(--color-text-muted);
    padding: 0.4rem 0;
    margin: -0.4rem 0;
    transition: color 0.15s ease;
  }

  nav a:hover,
  nav a[aria-current='page'] {
    color: var(--color-text);
  }

  .disabled-wrap {
    position: relative;
    display: inline-block;
  }

  nav .disabled {
    appearance: none;
    background: none;
    border: none;
    font-family: inherit;
    opacity: 0.45;
    cursor: not-allowed;
    user-select: none;
  }

  .tooltip {
    position: absolute;
    left: 0;
    top: 100%;
    margin-top: 2px;
    background: var(--color-text);
    color: var(--color-bg);
    font-size: 0.75rem;
    line-height: 1.4;
    padding: 0.25rem 0.55rem;
    border-radius: 4px;
    white-space: nowrap;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.15s ease;
    z-index: 20;
  }

  .disabled-wrap:hover .tooltip,
  .disabled-wrap:focus-within .tooltip,
  .disabled-wrap.show-tooltip .tooltip {
    opacity: 1;
    visibility: visible;
  }

  .social {
    list-style: none;
    display: flex;
    gap: var(--space-2);
    margin: var(--space-4) 0 0;
    padding: 0;
    margin-top: auto;
  }

  .social a {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border-radius: 999px;
    border: 1px solid var(--color-border);
    text-decoration: none;
    font-size: 0.7rem;
    font-weight: 600;
    color: var(--color-text-muted);
    transition: color 0.15s ease, border-color 0.15s ease;
  }

  .social a:hover {
    color: var(--color-text);
    border-color: var(--color-text-muted);
  }

  @media (max-width: 800px) {
    .sidebar {
      width: 100%;
      border-right: none;
      border-bottom: 1px solid var(--color-border);
      padding: var(--space-3);
    }

    nav ul {
      flex-direction: row;
      flex-wrap: wrap;
      gap: var(--space-3);
    }

    .social {
      margin-top: var(--space-3);
    }
  }
</style>
