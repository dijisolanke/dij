---
import type { IconDefinition } from '@fortawesome/fontawesome-common-types';
import {
  faBandcamp,
  faFacebookF,
  faInstagram,
  faSoundcloud,
  faSpotify,
  faTiktok,
  faXTwitter,
  faYoutube,
} from '@fortawesome/free-brands-svg-icons';
import { faLink } from '@fortawesome/free-solid-svg-icons';
import Icon from './Icon.astro';
import type { SocialLink } from '../lib/sanity';

interface Props {
  links: SocialLink[];
  size?: 'small' | 'large';
  artistName: string;
}

const { links, size = 'small', artistName } = Astro.props;

// Keys match the platform list in studio/schemaTypes/siteSettings.ts.
const icons: Record<string, IconDefinition> = {
  Instagram: faInstagram,
  TikTok: faTiktok,
  'Twitter / X': faXTwitter,
  Facebook: faFacebookF,
  YouTube: faYoutube,
  Spotify: faSpotify,
  Bandcamp: faBandcamp,
  Soundcloud: faSoundcloud,
};

const labels: Record<string, string> = { 'Twitter / X': 'X' };
---

{links.length > 0 && (
  <ul class:list={['social', `social--${size}`]}>
    {links.map((link) => (
      <li>
        <a href={link.url} target="_blank" rel="noopener noreferrer" title={labels[link.platform] || link.platform}>
          <Icon icon={icons[link.platform] || faLink} />
          <span class="visually-hidden">
            {artistName} on {labels[link.platform] || link.platform} (opens in a new tab)
          </span>
        </a>
      </li>
    ))}
  </ul>
)}

<style>
  .social {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    margin: 0;
    padding: 0;
  }

  .social a {
    display: flex;
    align-items: center;
    justify-content: center;
    width: var(--tap);
    height: var(--tap);
    color: var(--color-text);
    transition:
      opacity 0.2s ease,
      transform 0.2s ease;
  }

  .social a:hover {
    opacity: 0.7;
  }

  .social--small {
    gap: 0;
    font-size: 1.05rem;
  }

  .social--large {
    justify-content: center;
    gap: var(--space-2);
    font-size: 1.9rem;
  }

  .social--large a {
    width: 3.5rem;
    height: 3.5rem;
  }

  @media (prefers-reduced-motion: no-preference) {
    .social--large a:hover {
      transform: translateY(-3px);
    }
  }
</style>
