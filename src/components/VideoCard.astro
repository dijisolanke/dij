---
import { resolveEmbed, type VideoMedia } from '../lib/video';

interface Props {
  video: VideoMedia;
  /** Used for the accessible name when the video itself has no title. */
  fallbackTitle?: string;
}

const { video, fallbackTitle } = Astro.props;
const title = video.title || fallbackTitle || 'video';
const embed = video._type === 'videoLink' ? resolveEmbed(video.url) : null;
const uploadSrc = video._type === 'videoUpload' ? video.asset.url : null;
---

<figure class="video-card">
  {embed || uploadSrc ? (
    <div
      class="video-frame"
      data-video-frame
      data-title={title}
      data-embed-src={embed?.embedUrl}
      data-preview-src={embed?.previewUrl}
      data-upload-src={uploadSrc}
    >
      <button type="button" class="play-facade" aria-label={`Play ${title}`}>
        {embed ? (
          <img
            src={embed.thumbnailCandidates[0]}
            data-thumb-candidates={embed.thumbnailCandidates.slice(1).join(',')}
            alt=""
            loading="lazy"
            decoding="async"
          />
        ) : (
          // First frame doubles as the thumbnail; also used for the hover preview.
          <video src={`${uploadSrc}#t=0.1`} muted playsinline loop preload="metadata" tabindex="-1" aria-hidden="true" />
        )}
        <svg class="play-icon" viewBox="0 0 64 64" aria-hidden="true">
          <circle cx="32" cy="32" r="31" fill="rgba(0,0,0,0.55)" stroke="#fff" stroke-width="2" />
          <path d="M26 20v24l19-12-19-12z" fill="#fff" />
        </svg>
      </button>
    </div>
  ) : (
    video._type === 'videoLink' && (
      <a href={video.url} target="_blank" rel="noopener noreferrer" class="video-link">
        {title} (opens in a new tab)
      </a>
    )
  )}
  {video.title && <figcaption>{video.title}</figcaption>}
</figure>

<script>
  const canPreview = () =>
    window.matchMedia('(hover: hover) and (pointer: fine)').matches &&
    !window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  document.querySelectorAll<HTMLElement>('[data-video-frame]').forEach((frame) => {
    const facade = frame.querySelector<HTMLButtonElement>('.play-facade');
    if (!facade) return;
    const { embedSrc, previewSrc, uploadSrc, title } = frame.dataset;

    // Walk the thumbnail fallback chain when a provider image 404s.
    const thumb = facade.querySelector<HTMLImageElement>('img');
    thumb?.addEventListener('error', function onError() {
      const remaining = (thumb.dataset.thumbCandidates || '').split(',').filter(Boolean);
      const next = remaining.shift();
      thumb.dataset.thumbCandidates = remaining.join(',');
      if (next) thumb.src = next;
      else thumb.removeEventListener('error', onError);
    });

    // ----- Hover preview (mouse only; skipped for reduced motion) -----
    let hoverTimer: number | undefined;
    let previewFrame: HTMLIFrameElement | null = null;
    const uploadPreview = facade.querySelector<HTMLVideoElement>('video');

    const startPreview = () => {
      if (previewSrc && !previewFrame) {
        previewFrame = document.createElement('iframe');
        previewFrame.className = 'preview';
        previewFrame.src = previewSrc;
        previewFrame.allow = 'autoplay; encrypted-media';
        previewFrame.tabIndex = -1;
        previewFrame.setAttribute('aria-hidden', 'true');
        // Give the player a moment to start so the swap doesn't flash black.
        previewFrame.addEventListener('load', () => {
          window.setTimeout(() => previewFrame?.classList.add('is-playing'), 400);
        });
        facade.insertBefore(previewFrame, facade.querySelector('.play-icon'));
      } else if (uploadPreview) {
        uploadPreview.play().catch(() => {});
      }
      frame.classList.add('is-previewing');
    };

    const stopPreview = () => {
      window.clearTimeout(hoverTimer);
      previewFrame?.remove();
      previewFrame = null;
      if (uploadPreview) {
        uploadPreview.pause();
        uploadPreview.currentTime = 0.1;
      }
      frame.classList.remove('is-previewing');
    };

    facade.addEventListener('pointerenter', (event) => {
      if (event.pointerType !== 'mouse' || !canPreview()) return;
      // Short delay so sweeping the cursor across the page doesn't load players.
      hoverTimer = window.setTimeout(startPreview, 250);
    });
    facade.addEventListener('pointerleave', stopPreview);

    // ----- Click: swap in the full player with sound -----
    facade.addEventListener(
      'click',
      () => {
        stopPreview();
        let player: HTMLIFrameElement | HTMLVideoElement;
        if (embedSrc) {
          player = document.createElement('iframe');
          player.src = `${embedSrc}${embedSrc.includes('?') ? '&' : '?'}autoplay=1`;
          player.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
          player.allowFullscreen = true;
          player.title = title || 'Video player';
        } else if (uploadSrc) {
          player = document.createElement('video');
          player.src = uploadSrc;
          player.controls = true;
          player.autoplay = true;
          player.playsInline = true;
          player.setAttribute('aria-label', title || 'Video');
        } else {
          return;
        }
        frame.replaceChildren(player);
        frame.classList.add('is-playing');
        // Keep keyboard focus where the user was, now on the player.
        player.tabIndex = 0;
        player.focus({ preventScroll: true });
      },
      { once: true }
    );
  });
</script>

<style>
  .video-card {
    margin: 0;
  }

  .video-frame {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--color-surface-raised);
  }

  /* :global because the players are created at runtime by the script above,
     so Astro never sees them to attach its scoping attribute. */
  .video-frame :global(iframe),
  .video-frame :global(video) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    object-fit: cover;
  }

  .video-frame.is-playing :global(video) {
    object-fit: contain;
    background: #000;
  }

  .play-facade {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    padding: 0;
    border: 0;
    background: var(--color-surface-raised);
    cursor: pointer;
  }

  .play-facade img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s var(--ease-out);
  }

  /* The hover preview fades in over the thumbnail and never catches clicks. */
  .play-facade :global(iframe.preview) {
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.4s ease;
    /* Oversized to crop YouTube's title bar / logo out of the preview. */
    inset: -12% -2%;
    width: 104%;
    height: 124%;
  }

  .play-facade :global(iframe.preview.is-playing) {
    opacity: 1;
  }

  .play-icon {
    position: relative;
    z-index: 1;
    width: 4rem;
    height: 4rem;
    transition:
      transform 0.25s var(--ease-out),
      opacity 0.3s ease;
  }

  .play-facade:hover .play-icon {
    transform: scale(1.08);
  }

  .is-previewing .play-icon {
    opacity: 0.6;
  }

  .play-facade:focus-visible {
    outline: 3px solid var(--color-focus);
    outline-offset: -3px;
  }

  figcaption {
    margin-top: var(--space-2);
    font-weight: 700;
    font-size: 1.1rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    text-align: center;
  }

  .video-link {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
  }
</style>
