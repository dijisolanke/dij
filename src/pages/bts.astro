---
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import { getBtsEntries, urlFor, type SanityImage, type SanityFile } from '../lib/sanity';

Astro.response.headers.set('Cache-Control', 'public, s-maxage=60, stale-while-revalidate=300');

let entries: Awaited<ReturnType<typeof getBtsEntries>> = [];
let loadError = false;

try {
  entries = await getBtsEntries();
} catch {
  loadError = true;
}

function isImage(m: SanityImage | SanityFile): m is SanityImage {
  return m._type === 'mediaImage' || m._type === 'image';
}
---

<Layout title="BTS" description="Behind the scenes">
  <main class="container page">
    <h1>BTS</h1>

    {loadError && <p class="empty">Couldn't load this page right now. Please check back shortly.</p>}
    {!loadError && entries.length === 0 && <p class="empty">Nothing here yet — check back soon.</p>}

    {!loadError && entries.length > 0 && (
      <div class="feed">
        {entries.map((entry) => (
          <article
            class="entry"
            data-reveal={entry.revealStyle === 'tap-to-reveal' ? 'true' : undefined}
          >
            <div class="entry-cover">
              <span class="reveal-hint">Tap to reveal</span>
              <div class="entry-content">
                <h2>{entry.title}</h2>
                {entry.body && <p>{entry.body}</p>}
                {entry.media && entry.media.length > 0 && (
                  <div class="media">
                    {entry.media.map((m) =>
                      isImage(m) ? (
                        <img
                          src={urlFor(m).width(900).url()}
                          alt=""
                          loading="lazy"
                        />
                      ) : (
                        <video src={(m as SanityFile).asset.url} controls preload="none" />
                      )
                    )}
                  </div>
                )}
              </div>
            </div>
          </article>
        ))}
      </div>
    )}
  </main>
</Layout>

<script>
  document.querySelectorAll<HTMLElement>('.entry[data-reveal="true"]').forEach((entry) => {
    entry.addEventListener(
      'click',
      () => {
        entry.classList.add('revealed');
      },
      { once: true }
    );
  });
</script>

<style>
  .page {
    padding-top: var(--space-4);
    padding-bottom: var(--space-6);
  }

  .empty {
    color: var(--color-text-muted);
  }

  .feed {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    margin-top: var(--space-4);
    max-width: 640px;
  }

  .entry-content h2 {
    margin-bottom: var(--space-1);
  }

  .media {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin-top: var(--space-2);
  }

  .media img,
  .media video {
    width: 100%;
    border-radius: 4px;
  }

  .entry[data-reveal='true'] .entry-content {
    filter: blur(16px);
    user-select: none;
    transition: filter 0.4s ease;
  }

  .entry[data-reveal='true'] {
    cursor: pointer;
    position: relative;
  }

  .entry[data-reveal='true'] .reveal-hint {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.85rem;
    color: var(--color-text-muted);
    z-index: 1;
    pointer-events: none;
  }

  .entry[data-reveal='true'].revealed .entry-content {
    filter: none;
  }

  .entry[data-reveal='true'].revealed {
    cursor: default;
  }

  .entry[data-reveal='true'].revealed .reveal-hint {
    display: none;
  }
</style>
