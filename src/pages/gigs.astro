---
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import { getUpcomingGigs } from '../lib/sanity';

Astro.response.headers.set('Cache-Control', 'public, s-maxage=60, stale-while-revalidate=300');

let gigs: Awaited<ReturnType<typeof getUpcomingGigs>> = [];
let loadError = false;

try {
  gigs = await getUpcomingGigs();
} catch {
  loadError = true;
}

function formatDate(iso: string) {
  return new Date(iso).toLocaleDateString(undefined, {
    weekday: 'short',
    month: 'short',
    day: 'numeric',
    year: 'numeric',
  });
}

const isUrl = (value: string) => /^https?:\/\//i.test(value.trim());
---

<Layout title="Gigs" description="Upcoming shows">
  <main class="container page">
    <h1>Gigs</h1>

    {loadError && (
      <p class="empty">Couldn't load gigs right now. Please check back shortly.</p>
    )}

    {!loadError && gigs.length === 0 && (
      <p class="empty">No gigs announced yet — check back soon.</p>
    )}

    {!loadError && gigs.length > 0 && (
      <ul class="gigs-list">
        {gigs.map((gig) => (
          <li class="gig-row">
            <span class="gig-date">{formatDate(gig.date)}</span>
            <span class="gig-venue">
              {gig.venue}<span class="gig-city">, {gig.city}</span>
            </span>
            <span class="gig-status">
              {gig.soldOut ? (
                <span class="sold-out">Sold out</span>
              ) : (
                gig.notes &&
                (isUrl(gig.notes) ? (
                  <a href={gig.notes} target="_blank" rel="noopener noreferrer">Tickets</a>
                ) : (
                  <span class="notes">{gig.notes}</span>
                ))
              )}
            </span>
          </li>
        ))}
      </ul>
    )}
  </main>
</Layout>

<style>
  .page {
    padding-top: var(--space-4);
    padding-bottom: var(--space-6);
  }

  .empty {
    color: var(--color-text-muted);
  }

  .gigs-list {
    list-style: none;
    margin: var(--space-4) 0 0;
    padding: 0;
    border-top: 1px solid var(--color-border);
  }

  .gig-row {
    display: grid;
    grid-template-columns: 10rem 1fr auto;
    gap: var(--space-2);
    align-items: baseline;
    padding: var(--space-2) 0;
    border-bottom: 1px solid var(--color-border);
  }

  .gig-date {
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }

  .gig-city {
    color: var(--color-text-muted);
  }

  .sold-out,
  .notes {
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }

  @media (max-width: 640px) {
    .gig-row {
      grid-template-columns: 1fr;
      gap: var(--space-1);
    }
  }
</style>
