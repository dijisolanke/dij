---
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import { getUpcomingGigs } from '../lib/sanity';

Astro.response.headers.set('Cache-Control', 'public, s-maxage=60, stale-while-revalidate=300');

let gigs: Awaited<ReturnType<typeof getUpcomingGigs>> = [];
let loadError = false;

try {
  gigs = await getUpcomingGigs();
} catch {
  loadError = true;
}

function formatDate(iso: string) {
  return new Date(iso).toLocaleDateString(undefined, {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
  });
}

const isUrl = (value: string) => /^https?:\/\//i.test(value.trim());
---

<Layout title="Gigs" description="Upcoming shows">
  <main class="container page">
    <h1>Gigs</h1>

    {loadError && (
      <p class="empty">Couldn't load gigs right now. Please check back shortly.</p>
    )}

    {!loadError && gigs.length === 0 && (
      <p class="empty">No gigs announced yet — check back soon.</p>
    )}

    {!loadError && gigs.length > 0 && (
      <ul class="gigs-list">
        {gigs.map((gig) => (
          <li class="gig">
            <h2 class="gig-title">{gig.title || gig.venue}</h2>
            <p class="gig-meta">
              {formatDate(gig.date)}
              {gig.title ? ` — ${gig.venue}, ${gig.city}` : `, ${gig.city}`}
            </p>
            {gig.soldOut ? (
              <p class="sold-out">Sold out</p>
            ) : (
              gig.notes &&
              (isUrl(gig.notes) ? (
                <p><a href={gig.notes} target="_blank" rel="noopener noreferrer">Tickets</a></p>
              ) : (
                <p class="notes">{gig.notes}</p>
              ))
            )}
          </li>
        ))}
      </ul>
    )}
  </main>
</Layout>

<style>
  .page {
    padding-top: var(--space-4);
    padding-bottom: var(--space-6);
  }

  .empty {
    color: var(--color-text-muted);
  }

  .gigs-list {
    list-style: none;
    margin: var(--space-4) 0 0;
    padding: 0;
    max-width: 640px;
  }

  .gig {
    padding: var(--space-3) 0;
    border-bottom: 1px solid var(--color-border);
  }

  .gig:first-child {
    padding-top: 0;
  }

  .gig-title {
    font-size: 1.1rem;
    margin-bottom: 0.25rem;
  }

  .gig-meta {
    margin-bottom: 0;
  }

  .sold-out,
  .notes {
    margin: var(--space-1) 0 0;
    font-size: 0.9rem;
  }
</style>
