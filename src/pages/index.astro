---
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import { getAbout, urlFor } from '../lib/sanity';

Astro.response.headers.set('Cache-Control', 'public, s-maxage=60, stale-while-revalidate=300');

let about: Awaited<ReturnType<typeof getAbout>> = null;
let loadError = false;

try {
  about = await getAbout();
} catch {
  loadError = true;
}

const paragraphs = about?.bio ? about.bio.split(/\n\s*\n/).filter(Boolean) : [];
---

<Layout title={about ? `About ${about.name}` : 'Artist Name'} description={about?.bio}>
  <main class="container page">
    {loadError && <p class="empty">Couldn't load this page right now. Please check back shortly.</p>}

    {!loadError && !about && (
      <p class="empty">Content coming soon.</p>
    )}

    {about && (
      <article class="about">
        <h1>About {about.name}</h1>

        <img
          src={urlFor(about.heroImage).width(1000).height(1250).fit('crop').url()}
          alt={about.name}
          width="250"
          height="370"
          class="hero-image"
        />

        <div class="bio">
          {paragraphs.map((paragraph) => (
            <p>{paragraph}</p>
          ))}
        </div>
      </article>
    )}
  </main>
</Layout>

<style>
  .page {
    padding-top: var(--space-4);
    padding-bottom: var(--space-6);
  }

  .empty {
    color: var(--color-text-muted);
  }

  .about {
    max-width: 760px;
  }

  .hero-image {
    width: 100%;
    max-width: 560px;
    border-radius: 4px;
    object-fit: cover;
    margin-bottom: var(--space-4);
  }

  .bio p {
    max-width: 65ch;
  }
</style>
