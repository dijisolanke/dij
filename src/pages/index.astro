---
export const prerender = false;

import { faChevronDown } from '@fortawesome/free-solid-svg-icons';
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import VideoCard from '../components/VideoCard.astro';
import ProjectCarousel from '../components/ProjectCarousel.astro';
import ImageCarousel from '../components/ImageCarousel.astro';
import CarouselControls from '../components/CarouselControls.astro';
import SocialLinks from '../components/SocialLinks.astro';
import {
  getAbout,
  getProjects,
  getShopItems,
  getSiteSettings,
  getUpcomingGigs,
  getWatchEntries,
  isGigSoldOut,
  isSoldOut,
  urlFor,
  type SiteSettings,
} from '../lib/sanity';
import { findFeaturedVideo } from '../lib/video';

Astro.response.headers.set('Cache-Control', 'public, s-maxage=60, stale-while-revalidate=300');

// Each section loads independently, so one failing query only blanks its own section.
const [aboutRes, settingsRes, gigsRes, projectsRes, shopRes, watchRes] = await Promise.allSettled([
  getAbout(),
  getSiteSettings(),
  getUpcomingGigs(),
  getProjects(),
  getShopItems(),
  getWatchEntries(),
]);

const about = aboutRes.status === 'fulfilled' ? aboutRes.value : null;
const settings: SiteSettings =
  settingsRes.status === 'fulfilled' ? settingsRes.value : { siteName: 'Diji', shopEnabled: false };
const gigs = gigsRes.status === 'fulfilled' ? gigsRes.value : null;
const projects = projectsRes.status === 'fulfilled' ? projectsRes.value : null;
const shopItems = shopRes.status === 'fulfilled' ? shopRes.value : null;
const watchEntries = watchRes.status === 'fulfilled' ? watchRes.value : null;

const artistName = about?.name || settings.siteName || 'Diji';
const featured = watchEntries ? findFeaturedVideo(watchEntries) : null;
const heroCta = about?.heroCta?.label && about.heroCta.url ? about.heroCta : null;

const soundcloudEmbed = settings.soundcloudUrl
  ? `https://w.soundcloud.com/player/?url=${encodeURIComponent(settings.soundcloudUrl)}` +
    '&color=%23111111&auto_play=true&hide_related=true&show_comments=false&show_user=true&show_reposts=false&show_teaser=false'
  : null;

const isUrl = (value?: string) => !!value && /^https?:\/\//i.test(value.trim());

function formatGigDate(iso: string) {
  return new Date(iso).toLocaleDateString('en-GB', {
    day: 'numeric',
    month: 'short',
    year: 'numeric',
    timeZone: 'Europe/London',
  });
}

const formatPrice = (price: number, currency: string) =>
  new Intl.NumberFormat('en-GB', { style: 'currency', currency: currency || 'GBP' }).format(price);

const description = about?.bio?.split(/\n\s*\n/)[0] || `${artistName} — music, videos, live dates and projects.`;
---

<Layout title={artistName} description={description} settings={settings} overHero>
  <main id="main">
    <!-- ================= Hero ================= -->
    <section id="hero" class="hero" aria-labelledby="hero-title">
      {about?.heroImage && (
        <picture>
          <source
            media="(max-width: 799px)"
            srcset={[600, 900, 1200]
              .map((w) => `${urlFor(about.heroImage).width(w).height(Math.round(w * 1.78)).fit('crop').auto('format').quality(80).url()} ${w}w`)
              .join(', ')}
            sizes="100vw"
          />
          <img
            class="hero-image"
            src={urlFor(about.heroImage).width(1920).height(1080).fit('crop').auto('format').quality(80).url()}
            srcset={[1280, 1920, 2560]
              .map((w) => `${urlFor(about.heroImage).width(w).height(Math.round(w * 0.5625)).fit('crop').auto('format').quality(80).url()} ${w}w`)
              .join(', ')}
            sizes="100vw"
            alt=""
            fetchpriority="high"
            decoding="async"
          />
        </picture>
      )}
      <div class="hero-content">
        {/* The page's h1 for screen readers / SEO; visually the photo leads. */}
        <h1 id="hero-title" class="visually-hidden">{artistName}</h1>
        {heroCta && (
          <a href={heroCta.url} class="button hero-button" target="_blank" rel="noopener noreferrer">
            {heroCta.label}
            <span class="visually-hidden">(opens in a new tab)</span>
          </a>
        )}
        <a href="#music" class="scroll-cue" style="opacity:0.3">
          <span class="scroll-cue-label" aria-hidden="true">Scroll</span>
          <span class="scroll-cue-icon" aria-hidden="true">
            <Icon icon={faChevronDown}  />
          </span>
          <span class="visually-hidden">Scroll down to music</span>
        </a>
      </div>
    </section>

    <!-- ================= Music. ================= -->
    <section id="music" class="section" aria-labelledby="music-title">
      <div class="container narrow" data-reveal-on-scroll>
        <h2 id="music-title" class="section-title">Music Archive</h2>
        {soundcloudEmbed ? (
          <>
            {/* Click-to-load: SoundCloud sets its own cookies, so the player only loads once the visitor asks for it (UK PECR). */}
            <div class="soundcloud soundcloud-facade" data-soundcloud data-src={soundcloudEmbed} data-title={`${artistName} on SoundCloud`}>
              <button type="button" class="button" data-soundcloud-load>Load SoundCloud player</button>
              <p class="soundcloud-note">This loads a player from SoundCloud, which may set its own cookies.</p>
              <a class="soundcloud-more" href="/legal/privacy#cookies">More about cookies</a>
            </div>
            <p class="music-link">
              <a href={settings.soundcloudUrl} target="_blank" rel="noopener noreferrer">
                Listen on SoundCloud<span class="visually-hidden"> (opens in a new tab)</span>
              </a>
            </p>
          </>
        ) : (
          <p class="empty">New music coming soon.</p>
        )}
      </div>
    </section>

    <!-- ================= Watch ================= -->
    <section id="watch" class="section" aria-labelledby="watch-title">
      <div class="container narrow" data-reveal-on-scroll>
        <h2 id="watch-title" class="section-title">Watch</h2>
        {watchEntries === null && <p class="empty">Couldn't load videos right now. Please check back shortly.</p>}
        {watchEntries && !featured && watchEntries.length === 0 && <p class="empty">Videos coming soon.</p>}
        {featured && <VideoCard video={featured.video} fallbackTitle={featured.entry.title} />}
        {watchEntries && watchEntries.length > 0 && (
          <p class="section-cta">
            <a href="/watch" class="button">See more</a>
          </p>
        )}
      </div>
    </section>

    <!-- ================= Live ================= -->
    <section id="live" class="section" aria-labelledby="live-title">
      <div class="container narrow" data-reveal-on-scroll>
        <h2 id="live-title" class="section-title">Live</h2>
        {gigs === null && <p class="empty">Couldn't load live dates right now. Please check back shortly.</p>}
        {gigs && gigs.length === 0 && <p class="empty">No shows announced yet — check back soon.</p>}
        {gigs && gigs.length > 0 && (
          <ul class="gigs">
            {gigs.map((gig) => {
              const date = formatGigDate(gig.date);
              // Older gigs have no "ticketing" value: they behave as external links.
              const ticketing = gig.ticketing ?? 'external';
              const ticketUrl =
                ticketing === 'external' ? gig.ticketUrl || (isUrl(gig.notes) ? gig.notes : undefined) : undefined;
              const soldOut = ticketing === 'onsite' ? isGigSoldOut(gig) : gig.soldOut;
              return (
                <li class="gig">
                  <time class="gig-date" datetime={gig.date}>{date}</time>
                  <div class="gig-details">
                    {gig.title && <span class="gig-title">{gig.title}</span>}
                    <span class="gig-venue">{gig.venue}</span>
                    <span class="gig-city">{gig.city}</span>
                    {gig.notes && !isUrl(gig.notes) && <span class="gig-notes">{gig.notes}</span>}
                  </div>
                  <div class="gig-action">
                    {ticketing === 'none' ? null : soldOut ? (
                      <span class="sold-out">Sold out</span>
                    ) : ticketing === 'onsite' ? (
                      // Your own show: tickets are bought on this site.
                      <a href={`/tickets/${gig._id}`} class="button">
                        Tickets
                        <span class="visually-hidden">for {gig.venue}, {date}</span>
                      </a>
                    ) : (
                      ticketUrl && (
                        <a href={ticketUrl} class="button" target="_blank" rel="noopener noreferrer">
                          Tickets
                          <span class="visually-hidden">for {gig.venue}, {date} (opens in a new tab)</span>
                        </a>
                      )
                    )}
                  </div>
                </li>
              );
            })}
          </ul>
        )}
      </div>
    </section>

    <!-- ================= Projects ================= -->
    <section id="projects" class="section" aria-labelledby="projects-title">
      <div class="container narrow">
        <h2 id="projects-title" class="section-title" data-reveal-on-scroll>Projects</h2>
        {projects === null && <p class="empty">Couldn't load projects right now. Please check back shortly.</p>}
        {projects && projects.length === 0 && <p class="empty">Nothing here yet — check back soon.</p>}
        {projects && projects.length > 0 && (
          <div data-reveal-on-scroll>
            <ProjectCarousel projects={projects} />
          </div>
        )}
      </div>
    </section>

    <!-- ================= Shop ================= -->
    <section id="shop" class="section" aria-labelledby="shop-title">
      <div class="container" data-reveal-on-scroll>
        <h2 id="shop-title" class="section-title">Shop</h2>
        {!settings.shopEnabled ? (
          <p class="coming-soon">Coming soon</p>
        ) : shopItems === null ? (
          <p class="empty">Couldn't load the shop right now. Please check back shortly.</p>
        ) : shopItems.length === 0 ? (
          <p class="coming-soon">Coming soon</p>
        ) : (
          // Phones: one item at a time, swipeable, with Projects-style arrows + dots.
          // Tablet/desktop: a 2–3 column grid (controls hidden).
          <div class="shop-slider" data-slider data-slider-label="Item">
            <ul class="shop-grid" data-slider-track>
              {shopItems.map((item) => {
                const href = `/shop/${item.slug.current}`;
                return (
                  <li class="shop-slide" data-slider-slide data-title={item.title}>
                    <article class="shop-card">
                      <ImageCarousel
                        images={item.images}
                        alt={item.title}
                        href={href}
                        sizes="(min-width: 1080px) 340px, (min-width: 900px) 33vw, (min-width: 640px) 50vw, 100vw"
                      />
                      <a href={href} class="shop-card-link">
                        <span class="shop-title">{item.title}</span>
                        <span class="shop-price">
                          {isSoldOut(item) ? 'Sold out' : formatPrice(item.price, item.currency)}
                        </span>
                      </a>
                    </article>
                  </li>
                );
              })}
            </ul>
            {shopItems.length > 1 && (
              <div class="shop-slider-controls">
                <CarouselControls count={shopItems.length} label="item" titles={shopItems.map((i) => i.title)} />
              </div>
            )}
          </div>
        )}
      </div>
    </section>

    <!-- ================= Get Updates ================= -->
    {settings.socialLinks && settings.socialLinks.length > 0 && (
      <section id="updates" class="section" aria-labelledby="updates-title">
        <div class="container" data-reveal-on-scroll>
          <h3 id="updates-title" class="section-title get-updates">Get Updates</h3>
          <SocialLinks links={settings.socialLinks} artistName={artistName} size="large" />
        </div>
      </section>
    )}
  </main>
</Layout>

<script>
  // Swap the SoundCloud placeholder for the real player once the visitor asks for it.
  // The choice is remembered on this device so returning visitors get the player straight away.
  const KEY = 'soundcloud-ok';
  for (const box of document.querySelectorAll<HTMLElement>('[data-soundcloud]')) {
    const load = (autoplay: boolean) => {
      const frame = document.createElement('iframe');
      frame.className = 'soundcloud';
      frame.title = box.dataset.title ?? 'SoundCloud player';
      frame.allow = 'autoplay';
      frame.loading = 'lazy';
      frame.src = autoplay ? box.dataset.src! : box.dataset.src!.replace('auto_play=true', 'auto_play=false');
      box.replaceWith(frame);
    };
    let remembered = false;
    try {
      remembered = localStorage.getItem(KEY) === '1';
    } catch {}
    if (remembered) {
      load(false);
      continue;
    }
    box.querySelector('[data-soundcloud-load]')?.addEventListener('click', () => {
      try {
        localStorage.setItem(KEY, '1');
      } catch {}
      load(true);
    });
  }
</script>

<style>
  /* ---------- Hero ---------- */

  .hero {
    position: relative;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    min-height: 100vh;
    min-height: 100svh;
    overflow: hidden;
    background: var(--color-surface);
  }

  .hero picture,
  .hero-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .hero-image {
    object-fit: cover;
  }

  /* Bottom fade keeps the headline legible on any photo and blends into the page. */
  .hero::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, transparent 45%, rgba(0, 0, 0, 0.35) 70%, #000 100%);
    pointer-events: none;
  }

  .hero-content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
    padding: 0 var(--space-2) var(--space-5);
    text-align: center;
  }

  .scroll-cue {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
    min-width: var(--tap);
    padding: var(--space-1);
    text-decoration: none;
    /* Sit lower than the hero button without moving it. */
    position: relative;
    top: var(--space-4);
  }

  .scroll-cue-label {
    font-weight: 700;
    font-size: 0.5rem;
    text-transform: uppercase;
    letter-spacing: 0.3em;
    /* Optically re-centre: letter-spacing adds trailing space. */
    margin-right: -0.3em;
    text-shadow: 0 1px 8px rgba(0, 0, 0, 0.5);
  }

  .scroll-cue-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.17rem;
    height: 2.17rem;
    border: 1.5px solid var(--color-text);
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.25);
    font-size: 0.77rem;
    transition:
      background-color 0.2s ease,
      color 0.2s ease;
  }

  .scroll-cue:hover .scroll-cue-icon,
  .scroll-cue:focus-visible .scroll-cue-icon {
    background: var(--color-text);
    color: var(--color-bg);
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero-button,
    .scroll-cue {
      animation: hero-in 1.1s var(--ease-out) 0.3s both;
    }

    .scroll-cue-icon :global(.icon) {
      animation: scroll-nudge 1.8s ease-in-out 1.4s infinite;
    }

    @keyframes hero-in {
      from {
        opacity: 0;
        transform: translateY(40px);
      }
    }

    @keyframes scroll-nudge {
      0%,
      100% {
        transform: translateY(-2px);
        opacity: 1;
      }
      50% {
        transform: translateY(3.3px);
        opacity: 0.6;
      }
    }
  }

  /* ---------- Shared ---------- */

  .narrow {
    max-width: 900px;
  }

  .section-cta {
    margin: var(--space-4) 0 0;
    text-align: center;
  }

  /* ---------- Music ---------- */

  /* :global so the player iframe, which is added by script after the click, gets these sizes too. */
  :global(.soundcloud) {
    display: block;
    width: 100%;
    height: 380px;
    border: 0;
    background: var(--color-surface);
  }

  .soundcloud-facade {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    padding: var(--space-3);
    text-align: center;
  }

  .soundcloud-note {
    margin: 0;
    max-width: 36ch;
    font-size: 0.85rem;
    color: var(--color-text-muted);
  }

  .soundcloud-more {
    margin-top: calc(var(--space-2) * -1);
    font-size: 0.85rem;
    color: var(--color-text-muted);
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (min-width: 640px) {
    :global(.soundcloud) {
      height: 450px;
    }
  }

  .music-link {
    margin: var(--space-2) 0 0;
    text-align: center;
    font-size: 0.9rem;
  }

  .music-link a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    color: var(--color-text-muted);
  }

  .music-link a:hover {
    color: var(--color-text);
  }

  /* ---------- Live ---------- */

  .gigs {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--color-border);
  }

  .gig {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-1);
    padding: var(--space-3) 0;
    border-bottom: 1px solid var(--color-border);
  }

  @media (min-width: 700px) {
    .gig {
      grid-template-columns: 9rem minmax(0, 1fr) auto;
      align-items: center;
      gap: var(--space-3);
    }
  }

  .gig-date {
    font-weight: 900;
    font-size: 1.1rem;
    text-transform: uppercase;
  }

  .gig-details {
    display: flex;
    flex-direction: column;
  }

  .gig-title {
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-muted);
  }

  .gig-venue {
    font-weight: 700;
    font-size: 1.15rem;
  }

  .gig-city,
  .gig-notes {
    color: var(--color-text-muted);
  }

  .gig-notes {
    font-size: 0.9rem;
  }

  .gig-action {
    margin-top: var(--space-1);
  }

  @media (min-width: 700px) {
    .gig-action {
      margin-top: 0;
    }
  }

  @media (max-width: 699px) {
    .gig-action .button {
      width: 100%;
    }
  }

  .sold-out {
    display: inline-block;
    padding: 0.5rem 1rem;
    border: 2px solid var(--color-border);
    color: var(--color-text-muted);
    font-weight: 700;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    text-decoration: line-through;
  }

  /* ---------- Shop ---------- */

  .coming-soon {
    margin: 0;
    text-align: center;
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(1.4rem, 5vw, 2rem);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-text-muted);
  }

  /* Phones: horizontal, swipeable, one item per view (like Projects). */
  .shop-grid {
    position: relative; /* slide.offsetLeft is measured from the track */
    list-style: none;
    display: flex;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    overscroll-behavior-x: contain;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }

  .shop-grid::-webkit-scrollbar {
    display: none;
  }

  .shop-slide {
    flex: 0 0 100%;
    min-width: 0;
    scroll-snap-align: start;
    scroll-snap-stop: always;
  }

  /* Tablet+: a normal grid; the item carousel controls aren't needed. */
  @media (min-width: 640px) {
    .shop-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-4) var(--space-3);
      overflow: visible;
    }

    .shop-slider-controls {
      display: none;
    }
  }

  @media (min-width: 900px) {
    .shop-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .shop-card {
    display: flex;
    flex-direction: column;
    text-align: center;
  }

  .shop-card-link {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding-top: var(--space-1);
    text-decoration: none;
  }

  .shop-card-link:hover .shop-title {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .shop-title {
    font-weight: 900;
    font-size: 1.15rem;
    text-transform: uppercase;
  }

  .shop-price {
    color: var(--color-text-muted);
  }
  .get-updates{
    font-size: large;
  }
</style>
