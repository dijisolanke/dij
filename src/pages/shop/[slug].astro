---
export const prerender = false;

import { faArrowLeft } from '@fortawesome/free-solid-svg-icons';
import Layout from '../../layouts/Layout.astro';
import ImageCarousel from '../../components/ImageCarousel.astro';
import Icon from '../../components/Icon.astro';
import { getShopItemBySlug, getSiteSettings, isSoldOut, type SiteSettings } from '../../lib/sanity';
import { PUBLIC_TURNSTILE_SITE_KEY } from 'astro:env/client';

const { slug } = Astro.params;

let item: Awaited<ReturnType<typeof getShopItemBySlug>> = null;
let settings: SiteSettings | undefined;
let loadError = false;

try {
  [item, settings] = await Promise.all([getShopItemBySlug(slug!), getSiteSettings()]);
} catch {
  loadError = true;
}

if (!loadError && !item) {
  return Astro.redirect('/#shop');
}
// Old ticket shop items: tickets now live on the gig (Live section).
if (item?.type === 'digital-ticket') {
  return Astro.redirect('/#live');
}

// TODO(stripe launch): see docs/stripe-launch-checklist.md before turning the shop on.
const shopEnabled = settings?.shopEnabled ?? false;
const buyable = !!item && shopEnabled && !isSoldOut(item);
---

<Layout title={item ? item.title : 'Shop'} description={item?.description} settings={settings}>
  <main id="main" class="container page">
    <a href="/#shop" class="back-link">
      <Icon icon={faArrowLeft} />
      Back to shop
    </a>

    {loadError && <p class="empty">Couldn't load this item right now. Please check back shortly.</p>}

    {item && (
      <div class="detail">
        <ImageCarousel
          images={item.images}
          alt={item.title}
          arrows
          eager
          widths={[600, 900, 1200]}
          sizes="(min-width: 800px) 60vw, 100vw"
        />

        <div class="info">
          <h1>{item.title}</h1>
          <p class="price">
            {new Intl.NumberFormat(undefined, {
              style: 'currency',
              currency: item.currency || 'GBP',
            }).format(item.price)}
          </p>
          {item.description && <p class="description">{item.description}</p>}

          {!shopEnabled ? (
            <p class="status">Coming soon</p>
          ) : isSoldOut(item) ? (
            <p class="status">Sold out</p>
          ) : (
            <button
              class="button buy"
              data-buy
              data-payload={JSON.stringify({ slug: item.slug.current })}
              data-sitekey={PUBLIC_TURNSTILE_SITE_KEY}
              data-error="buy-error"
            >Buy</button>
          )}
          {/* Bot check: invisible unless Cloudflare needs the visitor to tick a box. */}
          {buyable && <div class="turnstile" data-turnstile></div>}
          {buyable && (
            // Key terms must be shown before purchase (Consumer Contracts Regs 2013).
            <p class="terms-note">
              Price includes delivery. 14-day returns — you pay return postage. Orders outside the UK may have import
              duties on arrival. By buying you agree to our <a href="/legal/terms">terms of sale</a>.
            </p>
          )}
          <p id="buy-error" class="buy-error" role="alert" hidden>Something went wrong — please try again.</p>
        </div>
      </div>
    )}
  </main>
</Layout>

{buyable && (
  <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit" async defer></script>
)}

<script>
  import { initBuyButtons } from '../../scripts/buy';
  initBuyButtons();
</script>

<style>
  .page {
    padding-top: var(--space-3);
    padding-bottom: var(--space-6);
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: var(--tap);
    margin-bottom: var(--space-3);
    font-weight: 700;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    text-decoration: none;
  }

  .back-link:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .detail {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
    gap: var(--space-4);
    align-items: start;
  }

  h1 {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(2rem, 6vw, 3rem);
    text-transform: uppercase;
  }

  .price {
    font-size: 1.25rem;
    font-weight: 700;
  }

  .description {
    max-width: 45ch;
    color: var(--color-text-muted);
  }

  .buy {
    width: 100%;
    max-width: 320px;
  }

  .status {
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-text-muted);
  }

  .turnstile {
    margin-top: var(--space-2);
  }

  .turnstile:empty {
    display: none;
  }

  .terms-note {
    margin-top: var(--space-2);
    max-width: 45ch;
    font-size: 0.85rem;
    color: var(--color-text-muted);
  }

  .terms-note a {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .buy-error {
    color: var(--color-text-muted);
    margin-top: var(--space-2);
  }

  @media (max-width: 800px) {
    .detail {
      grid-template-columns: minmax(0, 1fr); /* 1fr alone would grow to the carousel's full scroll width */
      gap: var(--space-3);
    }

    .buy {
      max-width: none;
    }
  }
</style>
