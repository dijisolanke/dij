---
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import { getShopItems, urlFor } from '../../lib/sanity';

Astro.response.headers.set('Cache-Control', 'public, s-maxage=60, stale-while-revalidate=300');

let items: Awaited<ReturnType<typeof getShopItems>> = [];
let loadError = false;

try {
  items = await getShopItems();
} catch {
  loadError = true;
}
---

<Layout title="Shop" description="Tickets and merch">
  <main class="container page">
    <h1>Shop</h1>

    {loadError && <p class="empty">Couldn't load the shop right now. Please check back shortly.</p>}
    {!loadError && items.length === 0 && <p class="empty">Nothing here yet — check back soon.</p>}

    {!loadError && items.length > 0 && (
      <ul class="grid">
        {items.map((item) => (
          <li>
            <a href={`/shop/${item.slug.current}`} class="card">
              <img
                src={urlFor(item.images[0]).width(600).height(600).fit('crop').url()}
                alt={item.title}
                loading="lazy"
                width="600"
                height="600"
              />
              <div class="card-body">
                <span class="card-title">{item.title}</span>
                <span class="card-price">
                  {item.soldOut
                    ? 'Sold out'
                    : new Intl.NumberFormat(undefined, {
                        style: 'currency',
                        currency: item.currency || 'USD',
                      }).format(item.price)}
                </span>
              </div>
            </a>
          </li>
        ))}
      </ul>
    )}
  </main>
</Layout>

<style>
  .page {
    padding-top: var(--space-4);
    padding-bottom: var(--space-6);
  }

  .empty {
    color: var(--color-text-muted);
  }

  .grid {
    list-style: none;
    margin: var(--space-4) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: var(--space-3);
  }

  .card {
    display: block;
    text-decoration: none;
    color: var(--color-text);
  }

  .card img {
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    border-radius: 4px;
    background: var(--color-border);
  }

  .card-body {
    display: flex;
    justify-content: space-between;
    padding-top: var(--space-1);
    font-size: 0.95rem;
  }

  .card-price {
    color: var(--color-text-muted);
  }
</style>
