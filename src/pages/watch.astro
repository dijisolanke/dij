---
export const prerender = false;

import { faArrowLeft } from '@fortawesome/free-solid-svg-icons';
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import VideoCard from '../components/VideoCard.astro';
import { getWatchEntries, urlFor } from '../lib/sanity';

Astro.response.headers.set('Cache-Control', 'public, s-maxage=60, stale-while-revalidate=300');

let entries: Awaited<ReturnType<typeof getWatchEntries>> = [];
let loadError = false;

try {
  entries = await getWatchEntries();
} catch {
  loadError = true;
}
---

<Layout title="Watch" description="Videos">
  <main id="main" class="container page">
    <a href="/#watch" class="back-link">
      <Icon icon={faArrowLeft} />
      Back to home
    </a>

    <h1 class="section-title">Watch</h1>

    {loadError && <p class="empty">Couldn't load this page right now. Please check back shortly.</p>}
    {!loadError && entries.length === 0 && <p class="empty">Nothing here yet — check back soon.</p>}

    {!loadError && entries.length > 0 && (
      <div class="feed">
        {entries.map((entry) => {
          const isHidden = entry.revealStyle === 'tap-to-reveal';
          return (
            <article class="entry" data-reveal-entry={isHidden ? '' : undefined} data-reveal-on-scroll>
              {isHidden && (
                <button type="button" class="reveal-button">
                  Tap to reveal
                  {entry.title && <span class="visually-hidden">: {entry.title}</span>}
                </button>
              )}
              <div class="entry-content" inert={isHidden}>
                {entry.title && <h2>{entry.title}</h2>}
                {entry.body && <p class="entry-body">{entry.body}</p>}
                {entry.media && entry.media.length > 0 && (
                  <div class="media">
                    {entry.media.map((m) =>
                      m._type === 'mediaImage' ? (
                        <img
                          src={urlFor(m).width(1200).auto('format').url()}
                          srcset={[600, 1200, 1800].map((w) => `${urlFor(m).width(w).auto('format').url()} ${w}w`).join(', ')}
                          sizes="(min-width: 1080px) 900px, 100vw"
                          alt=""
                          loading="lazy"
                          decoding="async"
                        />
                      ) : (
                        // Unembeddable links render as a plain link inside VideoCard.
                        <VideoCard video={m} fallbackTitle={entry.title} />
                      )
                    )}
                  </div>
                )}
              </div>
            </article>
          );
        })}
      </div>
    )}

    <p class="back-bottom">
      <a href="/" class="button">
        <Icon icon={faArrowLeft} />
        Back to home
      </a>
    </p>
  </main>
</Layout>

<script>
  document.querySelectorAll<HTMLElement>('[data-reveal-entry]').forEach((entry) => {
    const button = entry.querySelector<HTMLButtonElement>('.reveal-button');
    const content = entry.querySelector<HTMLElement>('.entry-content');
    button?.addEventListener(
      'click',
      () => {
        entry.classList.add('revealed');
        content?.removeAttribute('inert');
        button.remove();
        // Move focus into the revealed content so keyboard users land on it.
        const first = content?.querySelector<HTMLElement>('button, a, video, h2');
        if (first) {
          if (first.tagName === 'H2') first.tabIndex = -1;
          first.focus({ preventScroll: true });
        }
      },
      { once: true }
    );
  });
</script>

<style>
  .page {
    padding-top: var(--space-3);
    padding-bottom: var(--space-6);
    max-width: 960px;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: var(--tap);
    margin-bottom: var(--space-3);
    font-weight: 700;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    text-decoration: none;
  }

  .back-link:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .feed {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .entry {
    position: relative;
  }

  .entry-content h2 {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(1.5rem, 5vw, 2.25rem);
    text-transform: uppercase;
    margin-bottom: var(--space-1);
  }

  .entry-body {
    color: var(--color-text-muted);
    max-width: 65ch;
  }

  .media {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    margin-top: var(--space-2);
  }

  .media > img {
    width: 100%;
    height: auto;
  }

  /* ---------- Tap to reveal ---------- */

  [data-reveal-entry] .entry-content {
    filter: blur(18px);
    user-select: none;
    transition: filter 0.5s ease;
  }

  [data-reveal-entry].revealed .entry-content {
    filter: none;
    user-select: auto;
  }

  .reveal-button {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    border: 0;
    background: rgba(0, 0, 0, 0.25);
    color: var(--color-text);
    font: inherit;
    font-weight: 900;
    font-size: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    cursor: pointer;
  }

  .reveal-button:focus-visible {
    outline: 3px solid var(--color-focus);
    outline-offset: -3px;
  }

  .back-bottom {
    margin: var(--space-5) 0 0;
    text-align: center;
  }

  @media (prefers-reduced-motion: reduce) {
    [data-reveal-entry] .entry-content {
      transition: none;
    }
  }
</style>
