---
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import { getWatchEntries, urlFor, type WatchMedia } from '../lib/sanity';

Astro.response.headers.set('Cache-Control', 'public, s-maxage=60, stale-while-revalidate=300');

let entries: Awaited<ReturnType<typeof getWatchEntries>> = [];
let loadError = false;

try {
  entries = await getWatchEntries();
} catch {
  loadError = true;
}

interface ResolvedEmbed {
  embedUrl: string;
  thumbnailUrl: string | null;
  thumbnailFallbackUrl: string | null;
}

function youtubeEmbed(url: string): ResolvedEmbed | null {
  const watch = url.match(/[?&]v=([\w-]{11})/);
  const short = url.match(/youtu\.be\/([\w-]{11})/);
  const id = watch?.[1] || short?.[1];
  if (!id) return null;
  return {
    embedUrl: `https://www.youtube.com/embed/${id}`,
    thumbnailUrl: `https://img.youtube.com/vi/${id}/maxresdefault.jpg`,
    thumbnailFallbackUrl: `https://img.youtube.com/vi/${id}/hqdefault.jpg`,
  };
}

function vimeoEmbed(url: string): ResolvedEmbed | null {
  const match = url.match(/vimeo\.com\/(\d+)/);
  if (!match) return null;
  return {
    embedUrl: `https://player.vimeo.com/video/${match[1]}`,
    thumbnailUrl: null,
    thumbnailFallbackUrl: null,
  };
}
---

<Layout title="Watch" description="Videos">
  <main class="page">
    <h1>Watch</h1>

    {loadError && <p class="empty">Couldn't load this page right now. Please check back shortly.</p>}
    {!loadError && entries.length === 0 && <p class="empty">Nothing here yet — check back soon.</p>}

    {!loadError && entries.length > 0 && (
      <div class="feed">
        {entries.map((entry) => (
          <article
            class="entry"
            data-reveal={entry.revealStyle === 'tap-to-reveal' ? 'true' : undefined}
          >
            <div class="entry-cover">
              {entry.revealStyle === 'tap-to-reveal' && <span class="reveal-hint">Tap to reveal</span>}
              <div class="entry-content">
                {entry.title && <h2>{entry.title}</h2>}
                {entry.body && <p>{entry.body}</p>}
                {entry.media && entry.media.length > 0 && (
                  <div class="media">
                    {entry.media.map((m: WatchMedia) => {
                      if (m._type === 'mediaImage') {
                        return <img src={urlFor(m).width(900).url()} alt="" loading="lazy" />;
                      }
                      if (m._type === 'videoUpload') {
                        return (
                          <figure class="video">
                            <video src={m.asset.url} controls preload="none" />
                            {m.title && <figcaption>{m.title}</figcaption>}
                          </figure>
                        );
                      }
                      if (m._type === 'videoLink') {
                        const embed = youtubeEmbed(m.url) || vimeoEmbed(m.url);
                        return (
                          <figure class="video">
                            {embed ? (
                              <div class="embed-wrap" data-embed-src={embed.embedUrl}>
                                <button
                                  type="button"
                                  class="play-facade"
                                  aria-label={`Play ${m.title || entry.title || 'video'}`}
                                  data-fallback-thumb={embed.thumbnailFallbackUrl || undefined}
                                >
                                  {embed.thumbnailUrl && (
                                    <img src={embed.thumbnailUrl} alt="" loading="lazy" />
                                  )}
                                  <svg class="play-icon" viewBox="0 0 24 24" aria-hidden="true">
                                    <circle cx="12" cy="12" r="12" fill="rgba(255,255,255,0.9)" />
                                    <path d="M9.5 7.5v9l8-4.5-8-4.5z" fill="#1d1d1f" />
                                  </svg>
                                </button>
                              </div>
                            ) : (
                              <a href={m.url} target="_blank" rel="noopener noreferrer">
                                {m.title || 'Watch video'}
                              </a>
                            )}
                            {embed && m.title && <figcaption>{m.title}</figcaption>}
                          </figure>
                        );
                      }
                      return null;
                    })}
                  </div>
                )}
              </div>
            </div>
          </article>
        ))}
      </div>
    )}
  </main>
</Layout>

<script>
  document.querySelectorAll<HTMLElement>('.entry[data-reveal="true"]').forEach((entry) => {
    entry.addEventListener(
      'click',
      () => {
        entry.classList.add('revealed');
      },
      { once: true }
    );
  });

  document.querySelectorAll<HTMLImageElement>('.play-facade img').forEach((img) => {
    const fallback = img.closest<HTMLElement>('.play-facade')?.dataset.fallbackThumb;
    if (!fallback) return;
    img.addEventListener('error', () => { img.src = fallback; }, { once: true });
  });

  document.querySelectorAll<HTMLButtonElement>('.play-facade').forEach((button) => {
    button.addEventListener(
      'click',
      () => {
        const wrap = button.closest<HTMLElement>('.embed-wrap');
        const src = wrap?.dataset.embedSrc;
        if (!wrap || !src) return;

        const iframe = document.createElement('iframe');
        iframe.src = `${src}${src.includes('?') ? '&' : '?'}autoplay=1`;
        iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
        iframe.allowFullscreen = true;
        wrap.replaceChildren(iframe);
      },
      { once: true }
    );
  });
</script>

<style>
  .page {
    padding: var(--space-4) var(--space-3) var(--space-6);
  }

  .empty {
    color: var(--color-text-muted);
  }

  .feed {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    margin-top: var(--space-4);
  }

  @media (min-width: 801px) {
    .feed {
      max-width: 85%;
    }
  }

  .entry-content h2 {
    margin-bottom: var(--space-1);
  }

  .media {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin-top: var(--space-2);
  }

  .media img,
  .media video {
    width: 100%;
    border-radius: 4px;
  }

  .video {
    display: block;
    width: 100%;
    margin: 0;
  }

  .embed-wrap {
    position: relative;
    display: block;
    width: 100%;
    height: 0;
    padding-bottom: 56.25%;
    border-radius: 4px;
    overflow: hidden;
    background: var(--color-border);
  }

  .embed-wrap iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .play-facade {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    border: 0;
    background: var(--color-border);
    cursor: pointer;
  }

  .play-facade img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .play-icon {
    position: relative;
    width: 3.5rem;
    height: 3.5rem;
    filter: drop-shadow(0 2px 6px rgba(0, 0, 0, 0.35));
    transition: transform 0.15s ease;
  }

  .play-facade:hover .play-icon {
    transform: scale(1.08);
  }

  .video figcaption {
    margin-top: var(--space-1);
    font-size: 0.85rem;
    color: var(--color-text-muted);
  }

  .entry[data-reveal='true'] .entry-content {
    filter: blur(16px);
    user-select: none;
    transition: filter 0.4s ease;
  }

  .entry[data-reveal='true'] {
    cursor: pointer;
    position: relative;
  }

  .entry[data-reveal='true'] .reveal-hint {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.85rem;
    color: var(--color-text-muted);
    z-index: 1;
    pointer-events: none;
  }

  .entry[data-reveal='true'].revealed .entry-content {
    filter: none;
  }

  .entry[data-reveal='true'].revealed {
    cursor: default;
  }

  .entry[data-reveal='true'].revealed .reveal-hint {
    display: none;
  }
</style>
